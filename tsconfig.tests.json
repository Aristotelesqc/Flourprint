{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"]
  },
  "include": [
    "packages/*/test",
    "apps/*/test",
    "dogfood/*/importer/src",
    "dogfood/*/importer/test",
    "*.config.ts"
  ],
  "exclude": ["apps/mobile"]
}
