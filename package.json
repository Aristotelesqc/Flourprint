{
  "name": "flourprint",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json && tsc -p apps/mobile && tsc -p apps/mobile/tsconfig.node.json && tsc -p apps/desktop/tsconfig.e2e.json && tsc -p packages/ui && tsc -p docs/mockups/0.3-ux",
    "lint": "eslint .",
    "test": "tsc -b && vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm tokens:check && vitest run && pnpm test:backlog",
    "test:backlog": "node --test scripts/backlog-view.test.mjs",
    "build:mobile": "pnpm --filter @flourprint/mobile build",
    "build:desktop": "pnpm --filter @flourprint/desktop package",
    "tokens": "node scripts/ui-tokens.mjs",
    "tokens:check": "node scripts/ui-tokens.mjs --check",
    "catalogue": "node scripts/ui-catalogue.mjs serve",
    "build:catalogue": "node scripts/ui-catalogue.mjs build",
    "build:mockups": "node scripts/mockup-review.mjs build",
    "test:mockups": "node scripts/test-mockups.mjs",
    "capture:mockups": "node scripts/capture-mockups.mjs",
    "compare:mockups": "node scripts/compare-mockups.mjs",
    "capture:restoration": "node scripts/capture-restoration.mjs",
    "export:restoration": "node scripts/export-restoration.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
