{
  "name": "flourprint",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json && tsc -p apps/mobile && tsc -p apps/mobile/tsconfig.node.json && tsc -p apps/desktop/tsconfig.e2e.json",
    "lint": "eslint .",
    "test": "tsc -b && vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && vitest run && pnpm test:backlog",
    "test:backlog": "node --test scripts/backlog-view.test.mjs",
    "build:mobile": "pnpm --filter @flourprint/mobile build",
    "build:desktop": "pnpm --filter @flourprint/desktop package"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
