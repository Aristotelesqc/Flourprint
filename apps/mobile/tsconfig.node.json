{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "capacitor.config.ts",
    "playwright.config.ts",
    "e2e",
    "playwright.android.config.ts",
    "android-e2e",
    "playwright.android-upgrade.config.ts",
    "android-upgrade-e2e"
  ]
}
